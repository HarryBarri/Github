# Copy to .env for local dev, and set the same values in Vercel project settings.

# URL of your Google Apps Script web app (deployed from the waitlist sheet).
# When unset, signups fall back to a local data/waitlist.json file (dev only).
# See SETUP.md for how to create this.
SHEETS_WEBHOOK_URL=

# Optional shared secret. If set, it must match SHARED_SECRET in google-apps-script/Code.gs.
SHEETS_WEBHOOK_SECRET=
